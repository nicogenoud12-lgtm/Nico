{
  "mcpServers": {
    "gastos": {
      "command": "python3",
      "args": ["mcp/server.py"],
      "env": {
        "NICO_API_URL": "https://apigastos.genoud-nube.com.ar"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
