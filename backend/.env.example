# SQLite path (relativo al cwd)
DATABASE_URL=sqlite:///./gastos.db

# CORS – separar dominios por coma; en dev podés dejar *
CORS_ORIGINS=*

# Telegram bot
TELEGRAM_BOT_TOKEN=                    # token de @BotFather
TELEGRAM_WEBHOOK_SECRET=cambia-esto    # se valida en X-Telegram-Bot-Api-Secret-Token
ALLOWED_TELEGRAM_USER_IDS=             # ids separados por coma; vacío = permitir cualquiera (NO recomendado)
TELEGRAM_BOT_OWNER_ID=1                # user.id (tabla users) que recibe los gastos del bot

# Demo data en init (categorías y meses se siempre seedean; este flag agrega txs de ejemplo)
SEED_DEMO_TX=false

# Gemini (Google AI Studio) — para el parser del bot de Telegram
GEMINI_API_KEY=                        # AIza... obtenido en aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash          # modelo a usar (free-tier disponible)

# JWT — autenticación web
JWT_SECRET=                            # generar con: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080               # 7 días
